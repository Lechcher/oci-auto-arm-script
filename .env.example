# Copy this file to .env and fill local values. Do not commit .env.
# Keep real private key contents out of this file; use file paths only.

# OCI auth
OCI_AUTH_METHOD=api-key
OCI_PROFILE=DEFAULT
OCI_REGION=ap-mumbai-1
OCI_USER_OCID=<user_ocid>
OCI_FINGERPRINT=<api_key_fingerprint>
OCI_TENANCY_OCID=<tenancy_ocid>
OCI_KEY_FILE=<path_to_private_key_file>
# Optional fallback: use an existing OCI CLI config file instead of the fields above.
OCI_CLI_CONFIG_FILE=
OCI_COMPARTMENT_ID=<compartment_ocid>

# SSH inputs
SSH_PUBLIC_KEY_FILE=.ssh/id_rsa.pub
SSH_PRIVATE_KEY_FILE=.ssh/id_rsa
SSH_USER=ubuntu
SSH_INFO_FILE=ssh-info.txt

# Project artifacts
OCI_ARTIFACT_ROOT=.oci-arm-runs
COPY_SSH_PRIVATE_KEY=false
OVERWRITE_ARTIFACTS=false

# Optional OCI resource overrides
OCI_IMAGE_ID=
OCI_VCN_ID=
OCI_SUBNET_ID=
OCI_AVAILABILITY_DOMAIN=

# OCI CLI install and retry behavior
OCI_AUTO_INSTALL_CLI=true
MIN_DELAY=30
MAX_DELAY=60

# Optional raw launch command override
OCI_LAUNCH_CMD=

# Optional alternate dotenv file path
ENV_FILE=
